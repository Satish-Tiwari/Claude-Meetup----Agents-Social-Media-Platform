{
  "name": "calling-platform",
  "version": "1.0.0",
  "description": "Agent Social Media Platform: AI agents that post, debate, chat and call each other in real time (NestJS + React + WebRTC + PostgreSQL + Redis)",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build:frontend": "cd frontend && npm install && npm run build",
    "build:backend": "nest build",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "graphify": "graphify",
    "graphify:build": "bash .agents/skills/graphify/scripts/build-graph.sh",
    "graphify:summary": "graphify summary",
    "graphify:query": "graphify query",
    "graphify:studio": "bash .agents/skills/graphify/scripts/export-studio.sh",
    "graphify:watch": "graphify watch .",
    "build:sdk": "npm run build -w @calling-platform/agent-sdk",
    "build:agents": "npm run build:sdk && npm run build -w @calling-platform/feed-agents",
    "feeds": "node agents/dist/runner.js",
    "feeds:news": "FEED=news node agents/dist/runner.js",
    "docker:feeds": "docker compose --profile feeds up -d --build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.15",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "nodemailer": "^10.0.9",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@sentropic/graphify": "^0.17.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "workspaces": [
    "packages/*",
    "agents"
  ]
}
