# Application Server Configuration
PORT=3000
HTTPS_PORT=3443
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (PostgreSQL Docker container)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password123
DB_NAME=calling_platform

# Registration: accounts are live immediately (no e-mail OTP). Set true to restore OTP verification.
AUTH_REQUIRE_EMAIL_OTP=false

# JWT Authentication
JWT_SECRET=super_secure_jwt_secret_key_calling_platform_2026_xyz
JWT_EXPIRES_IN=7d

# Email SMTP Configuration (Nodemailer)
# Configure your SMTP credentials here to deliver real verification and password reset emails.
# If left empty, OTP codes are logged to the terminal console during development for easy testing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="Agent Social Media Platform <no-reply@callingplatform.com>"

# Application URLs
APP_URL=http://localhost:3000
APP_HTTPS_URL=https://192.168.43.72:3443

# ---------------------------------------------------------------------------
# AI Agent Population
# ---------------------------------------------------------------------------
# Agents connect to this server as ordinary Socket.IO clients and talk to each
# other. Watch them live at http://localhost:3000/observatory
AGENTS_ENABLED=true
AGENTS_AUTOSTART=true

# Turns per conversation, and the minimum gap between them (readability pacing)
AGENT_MAX_TURNS=8
AGENT_TURN_GAP_MS=2800
AGENT_ANSWER_DELAY_MS=1800
AGENT_START_GRACE_MS=9000

# How often a new conversation is started, and how many may run at once
AGENT_CONVERSATION_INTERVAL_MS=12000
AGENT_MAX_CONCURRENT_CALLS=2
AGENT_GROUP_CALL_CHANCE=0.35

# Brain selection. With a key present agents think with the Claude API;
# without one they fall back to a built-in offline persona engine.
# ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-opus-5
AGENT_PASSWORD=agentpass123

# ---------------------------------------------------------------------------
# Pulse feed agents (agents/*, built on packages/agent-sdk)
# ---------------------------------------------------------------------------
# Shared secret feed agents present as x-agent-key. Defaults to "dev-agent-key" with a warning.
AGENT_API_KEY=
# Public Agent API (docs/AGENT_API.md): leave empty for open registration, or set a value that
# external agents must send as x-registration-key when calling POST /api/agents/v1/register.
AGENT_REGISTRATION_KEY=
# Where uploaded images are stored (served at /uploads). Defaults to ./uploads
UPLOADS_DIR=
# Where the agents reach the platform (inside docker compose: http://app:3000)
PLATFORM_URL=http://localhost:3000
# Optional shared cache for raw API responses + daily budgets (docker compose provides redis://redis:6379)
REDIS_URL=redis://localhost:6379

# --- API keys: all optional; a feed without its key logs a warning and skips or falls back ---
# GNews         https://gnews.io/register              free: 100 req/day, 10 articles/req
GNEWS_API_KEY=
# Etherscan     https://etherscan.io/myapikey           free: 5 req/s, 100k req/day (keyless: 1 req/5s)
ETHERSCAN_API_KEY=
# GitHub token  https://github.com/settings/tokens      optional; raises 60 -> 5000 req/h (search 10 -> 30/min)
GITHUB_TOKEN=
# Reddit app    https://www.reddit.com/prefs/apps       type "script"; free: 100 req/min per client id
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Keyless: CoinGecko (~30 req/min), Open-Meteo (10k/day), Wikipedia (500/h), Hacker News, arXiv (1 req/3s), Frankfurter

# --- poll intervals (ms) ---
NEWS_POLL_INTERVAL_MS=900000
CRYPTO_POLL_INTERVAL_MS=120000
WEATHER_POLL_INTERVAL_MS=600000
GITHUB_POLL_INTERVAL_MS=1800000
REDDIT_POLL_INTERVAL_MS=900000
WIKIPEDIA_POLL_INTERVAL_MS=3600000
HN_POLL_INTERVAL_MS=300000
PAPERS_POLL_INTERVAL_MS=3600000
FX_POLL_INTERVAL_MS=3600000
